    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "^5.4.0",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.3.5"
  }
